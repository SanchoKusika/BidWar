{
  "name": "bidwar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "check:platform": "bash scripts/check-platform-isolation.sh",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff --linked",
    "db:types": "supabase gen types typescript --linked > src/shared/api/database.types.ts",
    "test": "deno test --allow-env supabase/functions",
    "test:db": "deno test --allow-env --allow-net --allow-read --allow-sys supabase/tests",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:platform && npm run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postgres": "^3.4.9",
    "prettier": "^3.6.2",
    "supabase": "^2.116.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
