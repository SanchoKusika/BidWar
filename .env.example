# Фронтенд (публичные, попадают в бандл)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Только для Edge Functions. Во фронт не попадает никогда.
# SUPABASE_SERVICE_ROLE_KEY=
# APP_VERSION=            # отдаётся функцией health, по умолчанию dev
# BOT_TOKEN=
# WEBHOOK_SECRET=
# Активный платёжный провайдер Edge Functions: mock до среза 1.10.
# Обязателен — дефолта нет, незаданная переменная роняет create-payment, а
# не молча подставляет мок (находка I9 финального ревью 1.5). Это и есть
# настоящий рубеж между тестовым контуром и боевым, не PREVIEW.mockPayments.
# PAYMENT_PROVIDER=mock

# Прямое подключение к Postgres — только для `npm run test:db` (см. план среза 1.5)
# SUPABASE_DB_URL=
